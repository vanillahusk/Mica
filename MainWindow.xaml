<Window x:Class="LightSession.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightSession" Width="1240" Height="820" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#1D1D1D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="14,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="◈" Foreground="{StaticResource AccentBrush}" FontSize="20" Margin="0,0,8,0"/>
          <TextBlock Text="LightSession" FontWeight="SemiBold" FontSize="15"/>
        </StackPanel>
        <TextBlock x:Name="DocumentTitle" Grid.Column="1" Text="轻量 Markdown 阅读器" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="28,0" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="打开文件" Click="OpenFile_Click"/>
          <Button Content="打开文件夹" Click="OpenFolder_Click"/>
          <Button x:Name="ReadButton" Content="阅读" Click="ReadMode_Click"/>
          <Button x:Name="SplitButton" Content="分栏" Click="SplitMode_Click"/>
          <Button x:Name="EditButton" Content="编辑" Click="EditMode_Click"/>
          <Button x:Name="SaveButton" Content="保存" Click="Save_Click" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="260" MinWidth="190"/><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <TextBox x:Name="SearchBox" Margin="12" TextChanged="SearchBox_TextChanged" ToolTip="筛选文档"/>
          <DockPanel Grid.Row="1" Margin="14,4,10,4">
            <TextBlock Text="同步会话" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock x:Name="ConversationCount" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
          </DockPanel>
          <ListBox x:Name="ConversationList" Grid.Row="2" SelectionChanged="ConversationList_SelectionChanged"/>
          <DockPanel Grid.Row="3" Margin="14,12,10,4">
            <TextBlock Text="本地文档" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock x:Name="DocumentCount" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
          </DockPanel>
          <ListBox x:Name="DocumentList" Grid.Row="4" SelectionChanged="DocumentList_SelectionChanged"/>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#252525"/>
      <Grid Grid.Column="2" x:Name="Workspace">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="EditorColumn" Width="0"/><ColumnDefinition x:Name="PreviewColumn"/></Grid.ColumnDefinitions>
        <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas" FontSize="14" BorderThickness="0" Padding="32,28" TextChanged="Editor_TextChanged"/>
        <Border x:Name="PreviewBorder" Grid.Column="1" Background="{StaticResource WindowBackground}">
          <FlowDocumentScrollViewer x:Name="Preview" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto" Background="Transparent"/>
        </Border>
        <Border x:Name="EmptyState" Grid.ColumnSpan="2" Background="{StaticResource WindowBackground}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
            <TextBlock Text="◈" Foreground="{StaticResource AccentBrush}" FontSize="42" HorizontalAlignment="Center"/>
            <TextBlock Text="开始阅读" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,8"/>
            <TextBlock Text="从左侧打开同步会话，或将 Markdown 文件拖到这里。你也可以打开一个本地文档文件夹。" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="24"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
