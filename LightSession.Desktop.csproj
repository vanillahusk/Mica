<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Mica</AssemblyName>
    <RootNamespace>LightSession.Desktop</RootNamespace>
    <Version>0.8.1</Version>
    <ApplicationIcon>Assets/mica.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);Mica/**;tests/**;ReaderWeb/node_modules/**;ReaderWeb/experiments/**;publish*/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/mica.ico" />
    <Content Include="scripts/Install-Mica.ps1" Link="Install-Mica.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="scripts/Install-Mica.cmd" Link="Install-Mica.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31"/>
    <Content Include="ReaderWeb/dist/**/*">
      <Link>ReaderAssets/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="samples/*.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckOfflineReaderAssets" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('ReaderWeb/dist/index.html')" Text="请先进入 ReaderWeb，运行 pnpm install --frozen-lockfile 和 pnpm build，生成离线阅读组件。" />
  </Target>
</Project>
