<Window x:Class="LightSession.Desktop.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接 ChatGPT" Width="520" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}">
  <Grid Margin="34">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Width="48" Height="48" HorizontalAlignment="Left" Background="#2E2A4A" CornerRadius="14">
      <TextBlock Text="↗" Foreground="{StaticResource AccentBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Row="1" Margin="0,20,0,22">
      <TextBlock Text="连接 ChatGPT 扩展" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="连接后，在 ChatGPT 右侧目录点击“同步到 Mica”，当前完整会话就会出现在这里。" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,8,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
      <TextBlock Text="1  打开 chrome://extensions，并开启开发者模式" Margin="0,0,0,10"/>
      <TextBlock Text="2  找到 LightSession，复制它的扩展 ID" Margin="0,0,0,10"/>
      <TextBlock Text="3  粘贴到下方，Mica 会完成本机连接"/>
    </StackPanel>
    <StackPanel Grid.Row="3" VerticalAlignment="Center">
      <TextBlock Text="扩展 ID" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,7"/>
      <TextBox x:Name="ExtensionIdBox" FontFamily="Cascadia Mono, Consolas" FontSize="14" Padding="12,10"/>
      <TextBlock x:Name="ErrorText" Foreground="#FF7B86" FontSize="12" Margin="2,7,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Click="Cancel_Click" Padding="18,8"/>
      <Button Content="完成连接" Click="Connect_Click" Style="{StaticResource PrimaryButton}" Padding="20,8"/>
    </StackPanel>
  </Grid>
</Window>
